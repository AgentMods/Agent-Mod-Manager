+def _download_name(metadata: dict) -> str:
+    row = metadata["modFile"]
+    detected = row.get("detectedFileExtension")
+    extension = detected.lower().removeprefix(".") if isinstance(detected, str) else ""
+    known_type = extension in _ARCHIVE_EXTENSIONS
+
+    # With a detected archive type, do not misread a display version like "1.2"
+    # as a file extension. Without one, preserve safe legacy filenames.
+    v1 = metadata.get("v1")
+    if isinstance(v1, dict) and (
+        name := _named_archive(v1.get("file_name"), require_known_suffix=known_type)
+    ):
+        return name
+    # A URI containing a path is an object key, not a source of local path parts.
+    if name := _named_archive(row.get("uri"), require_known_suffix=known_type):
+        return name
+
+    if not known_type:
+        raise ValueError("Nexus did not supply a supported archive extension.")
+
+    # The GraphQL UID identifies the release across games; names and file IDs alone do not.
+    uid = row.get("uid")
+    if type(uid) is int and 0 < uid < 10**20:
+        uid = str(uid)
+    if not isinstance(uid, str) or not re.fullmatch(r"[1-9][0-9]{0,19}", uid):
+        raise ValueError(
+            "Nexus did not supply a valid file UID for the archive filename."
+        )
+
+    title = row.get("name")
+    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", title) if isinstance(title, str) else ""
+    slug = slug.strip("._-")[:80].rstrip("._-") or "file"
+    return f"nexus-{slug}-{uid}.{extension}"
+
