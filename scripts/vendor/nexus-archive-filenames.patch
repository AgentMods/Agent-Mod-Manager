+def _named_archive(value: object, *, require_known_suffix: bool) -> str | None:
+    try:
+        name = archive_name(value)
+    except ValueError:
+        return None
+    suffix = PureWindowsPath(name).suffix
+    if not suffix or (
+        require_known_suffix and suffix[1:].lower() not in _ARCHIVE_EXTENSIONS
+    ):
+        return None
+    return name
+
