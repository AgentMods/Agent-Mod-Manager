+class DownloadPathTests(unittest.TestCase):
+    def setUp(self):
+        self.root = Path(self.enterContext(tempfile.TemporaryDirectory())).resolve()
+
+    def test_preserves_safe_original_archive_and_legacy_names(self):
+        for name, detected in (
+            ("Bundle.TAR.GZ", "zip"),
+            ("\u6a21\u7ec4.v1.7Z", "zip"),
+            ("Mod.jar", "zip"),
+            ("Modpack.mrpack", "zip"),
+            ("A mod's file.modpack", "modpack"),
+            ("Legacy.esm", None),
+            ("Split.7z.001", None),
+        ):
+            with self.subTest(name=name, detected=detected):
+                row = dict(FILE, detectedFileExtension=detected)
+                self.assertEqual(
+                    download_path(self.root, {"modFile": dict(row, uri=name)}).name,
+                    name,
+                )
+                self.assertEqual(
+                    download_path(
+                        self.root, {"modFile": row, "v1": {"file_name": name}}
+                    ).name,
+                    name,
+                )
+
+    def test_display_suffix_does_not_override_detected_archive_type(self):
+        label = "ZXuKongSwap 1.2"
+        row = dict(OPAQUE_FILE, name=label)
+        for metadata in (
+            {"modFile": dict(row, uri=label)},
+            {"modFile": row, "v1": {"file_name": label}},
+            {"modFile": dict(row, uri=label), "v1": {"file_name": "Label.data"}},
+        ):
+            with self.subTest(metadata=metadata):
+                self.assertEqual(
+                    download_path(self.root, metadata).name,
+                    "nexus-ZXuKongSwap-1.2-45586782880367.zip",
+                )
+        for rejected in ("../bad.zip", label, "Label.data", "archive.zip.exe"):
+            with self.subTest(rejected=rejected):
+                metadata = {
+                    "modFile": dict(FILE, detectedFileExtension="zip"),
+                    "v1": {"file_name": rejected},
+                }
+                self.assertEqual(download_path(self.root, metadata).name, FILE["uri"])
+
+    def test_opaque_uri_uses_detected_format_and_distinct_stable_uid(self):
+        first = download_path(self.root, {"modFile": OPAQUE_FILE})
