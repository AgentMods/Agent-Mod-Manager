{
  "schemaVersion": 1,
  "slug": "gta5-enhanced",
  "name": "GTA5 增强版 单机适配包",
  "gameName": "GTA5增强版",
  "version": "1.1.0",
  "coverUrl": "https://cdn.cloudflare.steamstatic.com/steam/apps/3240220/header.jpg",
  "platforms": [
    "windows"
  ],
  "steamAppId": "3240220",
  "markers": [
    {
      "path": "GTA5_Enhanced.exe",
      "kind": "file",
      "required": true,
      "platforms": [
        "windows"
      ]
    }
  ],
  "mcpServers": [
    {
      "id": "rpf",
      "name": "GTA V Enhanced · RPF 暂存",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "gta-rpf-mcp@latest"
      ]
    }
  ],
  "installRoots": [
    {
      "id": "game",
      "kind": "game",
      "relativePath": ".",
      "platforms": [
        "windows"
      ],
      "discoveryHints": [],
      "notes": "只审查与本版主程序同级且确有必要的文件。"
    },
    {
      "id": "scripts",
      "kind": "game",
      "relativePath": "scripts",
      "platforms": [
        "windows"
      ],
      "discoveryHints": [],
      "notes": "脚本及其同目录资源，保持子目录。"
    },
    {
      "id": "mods",
      "kind": "game",
      "relativePath": "mods",
      "platforms": [
        "windows"
      ],
      "discoveryHints": [],
      "notes": "RPF 专用派生产物；不是散装资源的通用复制根。"
    }
  ],
  "modTypes": [
    {
      "id": "scripthookv",
      "name": "Script Hook V",
      "root": "game",
      "extensions": [
        "dll"
      ],
      "notes": "依发行包、游戏版本和选件逐文件审查；不能将 bin/ 整份复制。"
    },
    {
      "id": "asi",
      "name": "ASI 插件",
      "root": "game",
      "extensions": [
        "asi"
      ],
      "notes": "根目录插件；保留作者指定的同目录配置及依赖，不自动安装加载器。"
    },
    {
      "id": "script",
      "name": "scripts 脚本或依赖",
      "root": "scripts",
      "extensions": [
        "dll",
        "cs",
        "vb"
      ],
      "notes": "仅作者明确指定的单机脚本及所选 API 同级资源；不得重复创建 scripts/scripts/。"
    },
    {
      "id": "game-root",
      "name": "人工确认的根目录组件",
      "root": "game",
      "extensions": [],
      "notes": "有明确作者目标和所选版本才准入。并非剩余文件或未知 DLL 的默认目的地。"
    },
    {
      "id": "rpf-gameconfig",
      "name": "RPF · 游戏配置",
      "root": "mods",
      "extensions": [
        "xml"
      ],
      "notes": "仅匹配所选版本的 gameconfig.xml；需要 RPF 任务，禁止普通复制或覆盖原版。"
    },
    {
      "id": "rpf-dlc",
      "name": "RPF · 独立 DLC",
      "root": "mods",
      "extensions": [
        "rpf"
      ],
      "notes": "只接收作者指定的 dlc.rpf；须在归档内核验 setup2.xml/nameHash。"
    },
    {
      "id": "rpf-vehicle",
      "name": "RPF · 散装载具",
      "root": "mods",
      "extensions": [
        "yft",
        "ytd"
      ],
      "notes": "需明确模型、组件与模板；替换包或未知格式不自动转换。"
    },
    {
      "id": "rpf-ped",
      "name": "RPF · 行人模型",
      "root": "mods",
      "extensions": [
        "ydd",
        "ymt",
        "ytd",
        "yft",
        "yld"
      ],
      "notes": "区分普通与 Streamed，核对模型名及组件目录；未匹配则停止。"
    }
  ],
  "archiveRules": [
    {
      "modType": "scripthookv",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "依发行包、游戏版本和选件逐文件审查；不能将 bin/ 整份复制。"
    },
    {
      "modType": "asi",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "根目录插件；保留作者指定的同目录配置及依赖，不自动安装加载器。"
    },
    {
      "modType": "script",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "仅作者明确指定的单机脚本及所选 API 同级资源；不得重复创建 scripts/scripts/。"
    },
    {
      "modType": "game-root",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "有明确作者目标和所选版本才准入。并非剩余文件或未知 DLL 的默认目的地。"
    },
    {
      "modType": "rpf-gameconfig",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "通过本版 RPF 任务替换暂存 update.rpf 中的 gameconfig.xml，完成后重新打开核对。"
    },
    {
      "modType": "rpf-dlc",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "读取 setup2.xml/nameHash，再在暂存 update.rpf 登记该 DLC。Enhanced 不生成 Menyoo 列表。"
    },
    {
      "modType": "rpf-vehicle",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "Enhanced 的散装车辆模板尚未验证，停止此项操作。"
    },
    {
      "modType": "rpf-ped",
      "layout": "manual",
      "sourcePrefix": null,
      "requiredFiles": [],
      "notes": "Enhanced 的行人模板尚未验证，停止此项操作。"
    }
  ],
  "loadOrder": {
    "kind": "loader_dependencies",
    "paths": [],
    "notes": "先核对与游戏 build 对应的加载器和脚本 API；不自动安装前置、不修改启动配置、不重排整份 dlclist.xml。"
  },
  "savePaths": [],
  "logPaths": [],
  "uninstallNotes": [
    "普通包只撤销本次登记的文件和备份，保留共用加载器、其他脚本、配置与存档。",
    "共享 RPF 只可使用同一游戏的受管贡献重建；基线、贡献或当前指纹不符则停止，禁止删除整个 mods/ 或替换原版归档。"
  ],
