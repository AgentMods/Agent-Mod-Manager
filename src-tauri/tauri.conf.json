{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Mod Manager",
  "version": "1.0.0",
  "identifier": "com.glossmod.amm",
  "build": {
    "beforeDevCommand": "yarn prepare:seven-zip && yarn prepare:mcp-runtime && yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn prepare:seven-zip && yarn prepare:mcp-runtime && yarn build",
    "beforeBundleCommand": "yarn prepare:seven-zip && yarn prepare:mcp-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Mod Manager",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/AgentMods/Agent-Mod-Manager/releases/latest/download/latest.json"],
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "installer/wizard.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "SimpChinese",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Spanish",
          "PortugueseBR",
          "Russian",
          "Italian"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/mcp-runtime/": "mcp-runtime/",
      "resources/seven-zip/": "seven-zip/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Agent-driven game mod manager",
    "longDescription": "Manage game mods through an agent with streamed conversations, reviewed file transactions, backups and recoverable trash."
  }
}
