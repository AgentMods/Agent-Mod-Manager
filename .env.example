# Agent Mod Manager 环境变量参考。普通启动、本地开发和无签名构建不需要手动设置变量。
# 不要提交真实密钥、令牌或签名私钥，也不要把它们放进任何 VITE_* 变量。
# 模型 API Key 和 Mod 来源 / 第三方 MCP 的凭据请在应用设置里填写，不从此文件读取。

# 自管凭据存储（可选）
# 默认首次启动会在应用数据目录自动生成 private/.env 和随机密钥；无需复制本模板。
# 只有使用自管密钥时，才把下面这一项填入私有的 .env 或 .env.* 文件：
# 必须恰好是 64 个十六进制字符（32 字节随机密钥）。已有凭据时须沿用原密钥。
# macOS/Linux 将文件权限设为 600，Windows 仅允许自己的账户访问。
AMM_STORE_ENCRYPTION_KEY=

# 以下本地选项需要在启动相应命令前设置为进程环境变量；不要仅写入仓库根目录 .env。

# 指向已存在的自管 .env 或 .env.* 文件的绝对路径；应用不会创建或覆盖此文件。
# AMM_STORE_ENV_FILE=
# 关闭正式桌面版的匿名统计。只要此变量存在就会关闭；要恢复统计请取消设置，不是改成 0。
# AMM_DISABLE_ANALYTICS=1

# MCP stdio 代理：仅以 --mcp-stdio 启动时两项都必填，普通桌面模式不需要。
# 填已启用的桌面 MCP 服务地址（数字回环 IP、显式端口、/mcp 路径）。
# AMM_MCP_ENDPOINT=http://127.0.0.1:<端口>/mcp
# 填该服务的 Bearer 令牌（64 个十六进制字符），不要通过命令行参数传入。
# AMM_MCP_TOKEN=

# 内置 Playwright 首次下载 Chromium 时，可按需使用已有的网络代理配置。
# HTTPS_PROXY=
# HTTP_PROXY=
# ALL_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1

# 构建和本地测试（可选）
# 手动指定 Python 3.11+ 解释器的绝对路径；不设则自动探测。
# AMM_BUILD_PYTHON=
# 指定 Tauri/Vite 开发主机；普通本机开发不需要。
# TAURI_DEV_HOST=
# Vite 缓存目录（默认 node_modules/.vite；Playwright 会按端口使用独立缓存）。
# VITE_CACHE_DIR=node_modules/.vite
# Playwright UI 测试端口（默认 1430；并行运行时可改用其他空闲端口）。
# PW_PORT=1430
# Fabric 冒烟脚本可用 JAVA_HOME 指定 JDK 目录（不设则从 PATH 查找）。
# JAVA_HOME=
# 仅用于手动启用的 Fabric 诊断 / RAR 测试，分别填冒烟脚本输出的目录、样本文件的绝对路径。
# AMM_FABRIC_SMOKE_DIR=
# AMM_RAR_SAMPLE=

# 签名发布：在 GitHub Actions 仓库设置中配置，不在本地 .env 配置。
# Variables：更新公钥；可选指定公开分发仓库，不设则使用当前仓库。
# TAURI_UPDATER_PUBLIC_KEY=
# AMM_RELEASE_REPOSITORY=owner/repo
# Secrets：签名私钥及其密码；发布到另一个仓库时配置具有 Contents 写权限的令牌。
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# AMM_RELEASE_TOKEN=
